AGENT_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat

# Optional second chat model. It appears in the web selector when a key is set.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2

# Required by Docker Compose to enable the isolated run_python capability.
# Use a random secret of at least 32 characters and the immutable sha256 image ID.
SANDBOX_CONTROLLER_TOKEN=
SANDBOX_IMAGE_DIGEST=
# Numeric group ID of /var/run/docker.sock on the Docker host.
DOCKER_GID=

# 单个上传文件上限，默认 256 MiB
DRAINAGE_MAX_UPLOAD_BYTES=268435456

# Public showcase only. Disables destructive and upload APIs and run_python.
DRAINAGE_DEMO_MODE=false
DRAINAGE_DEMO_REQUESTS_PER_MINUTE=3
DRAINAGE_DEMO_MAX_CONCURRENT_CHATS=2

# Legacy DeepSeek-compatible names are also supported by the app:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
