FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /controller

RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10002 controller \
    && useradd --system --uid 10002 --gid controller --no-create-home --shell /usr/sbin/nologin controller

COPY requirements-controller.txt .
RUN pip install --no-cache-dir --requirement requirements-controller.txt

COPY --chown=root:root agent/python_sandbox.py agent/python_sandbox.py
COPY --chown=root:root sandbox_controller sandbox_controller

USER 10002:10002
ENTRYPOINT ["uvicorn", "sandbox_controller.main:app", "--host", "0.0.0.0", "--port", "8080"]
